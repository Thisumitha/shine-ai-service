# Copy to .env and fill in. Never commit .env.

# Must equal the Spring backend's jwt.secret
JWT_SECRET=
# Shared with the backend hook that calls /internal/index
INTERNAL_SECRET=
# Spring backend base URL, e.g. http://localhost:8080
SPRING_BASE_URL=http://localhost:8080

# AI provider (used in later phases)
GEMINI_API_KEY=

# Storage on the Docker volume (used in later phases)
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/service.sqlite

PORT=8000
