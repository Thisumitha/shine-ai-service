# Copy to .env and fill in. Never commit .env.

# Required: a Google Gemini API key (https://aistudio.google.com/apikey).
# Used for embeddings (ingestion + search) and for the answer / verifier LLM.
GEMINI_API_KEY=
# Who writes the answers: gemini, or ollama (free local model, see below). Embeddings always use Gemini.
LLM_PROVIDER=gemini
# Which AI writes the answers, classifies the question and checks the answer:
#   true  = fully on Gemini (GEMINI_MODEL, then GEMINI_FALLBACK_MODELS)
#   false = fully on Claude Code (needs the `claude` command signed in; data goes to Anthropic, billed to that account)
#   auto  = use LLM_CHAIN below (for example Gemini first, switching to Claude Code if it fails)
# Embeddings (indexing and meaning-based search) always use Gemini, in every mode.
USE_GEMINI=auto
# Answer models, tried left to right; the first that works answers (gemini:<model>, claude-code, ollama).
# A model that has another one behind it gives up after LLM_FAST_SWITCH_ATTEMPTS, so the switch is quick.
# claude-code runs the `claude` command with your own Claude login (tools off). It sends the question and
# the retrieved course text to Anthropic and is billed to that account. Empty = the older settings below.
LLM_CHAIN=gemini:gemini-3.8-flash,claude-code,gemini:gemini-3.5-flash-lite,ollama
LLM_FAST_SWITCH_ATTEMPTS=1
CLAUDE_CODE_MODEL=haiku
CLAUDE_CODE_TIMEOUT_SECONDS=90
# Last resort: when Gemini and every GEMINI_FALLBACK_MODELS entry fail, answer with Ollama. Empty = off.
LLM_FALLBACK_PROVIDER=ollama
# For LLM_PROVIDER=ollama: install Ollama, then `ollama pull qwen2.5:3b` (about 2 GB, runs on a normal laptop).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_MODEL=gemini-3.8-flash
# Tried in this order when the model above is busy, over quota, or not found.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Embedding model for ingestion and search. If you change it, run: python -m app.cli reset, then ingest again.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=5
# Wait before the first retry when Gemini is busy (503/429); doubles each retry, capped at 30s.
GEMINI_BACKOFF_SECONDS=3
# Seconds before a hung Gemini call is abandoned and retried.
GEMINI_TIMEOUT_SECONDS=30

# Storage (all local, created automatically)
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/service.sqlite
DATABASE_URL=sqlite:///./data/jobs.sqlite
PDF_DIR=./data/pdfs
MAX_PDF_MB=50

# OCR for scanned pages (optional; text PDFs work without Tesseract).
# Leave TESSERACT_CMD empty if tesseract is on PATH.
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_MAX_PAGES=200

# ---- Optional: Spring backend integration (leave empty for standalone use) ----
# Empty SPRING_BASE_URL = student questions are answered from sample/student_data.json (mock data).
SPRING_BASE_URL=
INTERNAL_SECRET=
STUDENT_DATA_TIMEOUT_SECONDS=10
PORT=8000
