# Copy to .env and fill in. Never commit .env.

# Must equal the Spring backend's jwt.secret
JWT_SECRET=
# Shared with the backend hook that calls /internal/index
INTERNAL_SECRET=
# Spring backend base URL, e.g. http://localhost:8080
SPRING_BASE_URL=http://localhost:8080
# Timeout when reading student records (timetable, invoices, attendance) from Spring
STUDENT_DATA_TIMEOUT_SECONDS=10

# AI provider (used in later phases)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=3

# Storage on the Docker volume (used in later phases)
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/service.sqlite
# MySQL database for the job queue. Create it first: CREATE DATABASE shine_ai CHARACTER SET utf8mb4;
# Format: mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/shine_ai
# Where uploaded PDFs are kept until they are processed
PDF_DIR=./data/pdfs
MAX_PDF_MB=50
# OCR for scanned pages (Tesseract). Leave TESSERACT_CMD empty if tesseract is on PATH,
# otherwise e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Languages joined with +, e.g. eng+sin+tam (each needs its traineddata file installed)
OCR_LANGUAGE=eng
# Pages beyond this are not OCR'd (cost/time cap)
OCR_MAX_PAGES=200

PORT=8000
